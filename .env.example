# Server Configuration
PORT=5000
NODE_ENV=production

# CORS Configuration
# Use * to allow all origins, or comma-separated list of allowed origins
ALLOWED_ORIGINS=*

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# NanobananaAPI Configuration (for image generation)
NANOBANANA_API_KEY=your_nanobanana_api_key_here

# Optional: Database path (defaults to ./data/fashion_arena.db)
# DATABASE_PATH=./data/fashion_arena.db

# Optional: Log level (info, warn, error, debug)
# LOG_LEVEL=info
